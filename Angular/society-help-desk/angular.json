{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "society-help-desk": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/society-help-desk",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "styles": [
              "src/styles.css",
              "src/lab/lab.css",
              "src/forms/forms-lab.css",
              "src/di/di-execution.css",
              "src/api/training-execution.css",
              "src/routing/routing-execution.css"
            ]
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": {
              "buildTarget": "society-help-desk:build"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
